# .dockerignore — keep the build context small and secret-free

# VCS
.git
.gitignore
.github

# Dev artifacts
tests
README.md

# docs/ is included in the image — the /docs/ viewer serves the user guides
# (usage, troubleshooting, setup/*) from /app/docs/. Exclude only the
# internal plan/spec subtree which is large and not user-facing.
docs/superpowers

# Python caches (glob patterns need ** to recurse in .dockerignore)
**/__pycache__
**/*.pyc
.pytest_cache
.mypy_cache
.ruff_cache

# Local state — MUST never enter the image
data
candidate_context
companies
logs
.tmux.conf
manual_job.txt

# Personal config / credentials — gitignored files still land in Docker context
# unless excluded here. Keep PII and secrets out of the build entirely.
CLAUDE.local.md

# config/ — DENY BY DEFAULT.  Everything under config/ is excluded, then the
# tracked files the image actually needs are re-included by name.  The previous
# form listed operator-personal files to exclude by exact name and carried a
# "keep this in sync with .gitignore" comment; it drifted.  Eleven gitignored
# paths -- including config/gmail.json, which holds a live IMAP app password --
# were reaching the build context, and Dockerfile's `COPY config/
# /opt/findajob/bundled-config/` puts anything in the context into the image.
# ops/entrypoint.sh then copies bundled-config over $JSP_BASE/config on every
# start, so a stray file does not just bloat the image, it overwrites the
# running instance's own config.  A deny-list needs updating whenever a new
# personal config file appears; this allow-list does not.
config/*
!config/roles/
!config/tool_prompts/
!config/model_pricing.yaml
!config/scoring_schema.json
!config/reference.docx
!config/strip-bookmarks.lua
!config/audit_exclusions.yaml
!config/loose_ends_walkthroughs.yaml
!config/loose_ends_walkthrough_exclusions.yaml
!config/*.example

# Editor / OS
.DS_Store
.vscode
.idea

# Release / build artifacts
dist
build
**/*.egg-info
