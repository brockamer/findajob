# .dockerignore — keep the build context small and secret-free

# VCS
.git
.gitignore
.github

# Docs / dev artifacts
docs
tests
README.md

# Python caches (glob patterns need ** to recurse in .dockerignore)
**/__pycache__
**/*.pyc
.pytest_cache
.mypy_cache
.ruff_cache

# Local state — MUST never enter the image
data
candidate_context
companies
logs
.tmux.conf
manual_job.txt

# Personal config / credentials — gitignored files still land in Docker context
# unless excluded here. Keep PII and secrets out of the build entirely.
CLAUDE.local.md

# config/ — only roles/ is baked into the image (handled by Dockerfile COPY).
# Exclude everything else (OAuth client, tokens, sheet IDs, personal YAML/txt).
config
!config/roles
!config/roles/**

# Editor / OS
.DS_Store
.vscode
.idea

# Release / build artifacts
dist
build
**/*.egg-info
